<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
  <Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />
  <!--
       Casting bar: "Gilded" (dracula skin)
       - 20px bar with a gold bevel (light top, dark bottom), dark inset and a deep-purple fill
       - gold diamond end caps are part of the left / right frame pieces (the game drew separate
         cap pieces underneath the frame). The left piece also carries the first 6px of fill under its
         diamond, so the fill reaches the frame edge; the gauge carries on from there.
       - the spell name is centred on the bar in pale gold (#F1E0AA)
       - frame drawn as crisp left / middle / right pieces so the rounded ends never stretch
       - window is transparent and borderless, 202 x 20 (the bar plus room for the caps)
       All art is on hud_pieces.dds.
  -->
  <Ui2DAnimation item="A_CW_FrameLeft">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>hud_pieces.dds</Texture>
      <Location>
        <X>157</X>
        <Y>169</Y>
      </Location>
      <Size>
        <CX>14</CX>
        <CY>20</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
