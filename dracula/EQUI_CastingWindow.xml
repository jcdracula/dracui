<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
  <Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />
  <!-- ============================================================
       Modernized casting bar (Slate Glass HUD), spell name inside the bar
       - one 20px rounded bar: dark inset track with a steel rim, purple fill with a soft sheen
       - the spell name sits centred on the bar in crisp white (it used to float above in yellow,
         where it got lost among nameplates and other text)
       - window 200 x 30 (was 52 tall)
       Art: cw_pieces.png
       ============================================================ -->
  <TextureInfo item="cw_pieces.png">
    <Size>
      <CX>128</CX>
      <CY>64</CY>
    </Size>
  </TextureInfo>
  <Ui2DAnimation item="A_CWGaugeBackground">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>cw_pieces.png</Texture>
      <Location>
        <X>0</X>
        <Y>0</Y>
      </Location>
      <Size>
        <CX>100</CX>
        <CY>20</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
  <Ui2DAnimation item="A_CWGaugeFill">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>cw_pieces.png</Texture>
      <Location>
        <X>0</X>
        <Y>24</Y>
      </Location>
      <Size>
        <CX>100</CX>
        <CY>20</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
  <Gauge item="Casting_Gauge">
    <ScreenID>Gauge</ScreenID>
    <RelativePosition>true</RelativePosition>
    <AutoStretch>true</AutoStretch>
    <TopAnchorOffset>0</TopAnchorOffset>
    <BottomAnchorOffset>20</BottomAnchorOffset>
    <LeftAnchorOffset>0</LeftAnchorOffset>
    <RightAnchorOffset>0</RightAnchorOffset>
    <TopAnchorToTop>true</TopAnchorToTop>
    <BottomAnchorToTop>true</BottomAnchorToTop>
    <LeftAnchorToLeft>true</LeftAnchorToLeft>
    <RightAnchorToLeft>false</RightAnchorToLeft>
    <GaugeOffsetY>0</GaugeOffsetY>
    <Style_VScroll>false</Style_VScroll>
    <Style_HScroll>false</Style_HScroll>
    <Style_Transparent>false</Style_Transparent>
    <FillTint>
      <R>189</R>
      <G>147</G>
      <B>249</B>
    </FillTint>
    <DrawLinesFill>false</DrawLinesFill>
    <EQType>7</EQType>
    <GaugeDrawTemplate>
      <Background>A_CWGaugeBackground</Background>
      <Fill>A_CWGaugeFill</Fill>
    </GaugeDrawTemplate>
  </Gauge>
  <Label item="Casting_SpellName">
    <ScreenID />
    <EQType>134</EQType>
    <Font>2</Font>
    <TextColor>
      <R>244</R>
      <G>246</G>
      <B>250</B>
    </TextColor>
    <RelativePosition>true</RelativePosition>
    <AutoStretch>true</AutoStretch>
    <LeftAnchorOffset>6</LeftAnchorOffset>
    <TopAnchorOffset>3</TopAnchorOffset>
    <RightAnchorOffset>6</RightAnchorOffset>
    <BottomAnchorOffset>19</BottomAnchorOffset>
    <TopAnchorToTop>true</TopAnchorToTop>
    <BottomAnchorToTop>true</BottomAnchorToTop>
    <LeftAnchorToLeft>true</LeftAnchorToLeft>
    <RightAnchorToLeft>false</RightAnchorToLeft>
    <Text />
    <NoWrap>true</NoWrap>
    <AlignCenter>true</AlignCenter>
    <AlignRight>false</AlignRight>
  </Label>
  <Screen item="CastingWindow">
    <!--<ScreenID/>-->
    <!--<Font/>-->
    <RelativePosition>false</RelativePosition>
    <Location>
      <X>290</X>
      <Y>50</Y>
    </Location>
    <Size>
      <CX>200</CX>
      <CY>30</CY>
    </Size>
    <Style_VScroll>false</Style_VScroll>
    <Style_HScroll>false</Style_HScroll>
    <Style_Transparent>false</Style_Transparent>
    <TooltipReference>Spell Casting Time</TooltipReference>
    <DrawTemplate>WDT_RoundedNoTitle</DrawTemplate>
    <Style_Titlebar>false</Style_Titlebar>
    <Style_Closebox>false</Style_Closebox>
    <Style_Minimizebox>false</Style_Minimizebox>
    <Style_Border>true</Style_Border>
    <Style_Sizable>false</Style_Sizable>
    <Escapable>false</Escapable>
    <Pieces>Casting_Gauge</Pieces>
    <Pieces>Casting_SpellName</Pieces>
  </Screen>
</XML>