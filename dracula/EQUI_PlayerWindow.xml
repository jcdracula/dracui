  <!-- ============================================================
       Modernized player window (Slate Glass HUD panel, like target / pet / group)
       - health 14px (#FF5555), mana and endurance 4px, stacked with no gaps, all on the
         theme's bar art with matching end caps; name and numbers stay hidden
       - combat-state icon beside the bars, redrawn so each state reads at a glance:
         swords = in combat, hourglass = combat timer, down arrow = debuffed,
         ring = standing, plus = regenerating (pw_pieces.png)
       - combat timer as a slim bar with its countdown beside it; aggro readouts hidden
         (the target and extended target windows show aggro); group role icons on their
         own row at the bottom (default height 52 shows bars and timer; drag the window
         ~16px taller to show role icons)
       - the auto-attack frame outlines the bar block
       ============================================================ -->
  <TextureInfo item="AttackIndicator.tga">
    <Size>
      <CX>128</CX>
      <CY>32</CY>
    </Size>
  </TextureInfo>
  <TextureInfo item="pw_pieces.png">
    <Size>
      <CX>128</CX>
      <CY>32</CY>
    </Size>
  </TextureInfo>
