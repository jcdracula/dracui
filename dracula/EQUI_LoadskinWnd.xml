<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
	<Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />

	<!-- ============================================================
	     Modernized Load Skin window
	     - wider fixed-size window so long skin names are readable
	     - "keep layout" is a real checkbox, so its on/off state is obvious
	     - uses the shared modern theme from EQUI_Templates.xml
	     ============================================================ -->

	<Label item="SKINW_SkinLabel">
		<ScreenID>SkinLabel</ScreenID>
		<Font>2</Font>
		<RelativePosition>true</RelativePosition>
		<AutoStretch>true</AutoStretch>
		<TopAnchorToTop>true</TopAnchorToTop>
		<BottomAnchorToTop>true</BottomAnchorToTop>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>false</RightAnchorToLeft>
		<TopAnchorOffset>6</TopAnchorOffset>
		<BottomAnchorOffset>20</BottomAnchorOffset>
		<LeftAnchorOffset>10</LeftAnchorOffset>
		<RightAnchorOffset>10</RightAnchorOffset>
		<Text>Installed skins</Text>
		<TextColor>
			<R>138</R>
			<G>163</G>
			<B>255</B>
		</TextColor>
		<NoWrap>true</NoWrap>
		<AlignCenter>false</AlignCenter>
		<AlignRight>false</AlignRight>
	</Label>

	<Listbox item="SKINW_SkinList">
		<ScreenID>SkinList</ScreenID>
		<DrawTemplate>WDT_AchPanel</DrawTemplate>
		<RelativePosition>true</RelativePosition>
		<AutoStretch>true</AutoStretch>
		<TopAnchorToTop>true</TopAnchorToTop>
		<BottomAnchorToTop>false</BottomAnchorToTop>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>false</RightAnchorToLeft>
		<TopAnchorOffset>22</TopAnchorOffset>
		<BottomAnchorOffset>64</BottomAnchorOffset>
		<LeftAnchorOffset>8</LeftAnchorOffset>
		<RightAnchorOffset>8</RightAnchorOffset>
		<TooltipReference>Select a skin, then click Load Skin</TooltipReference>
		<Columns>
			<!-- wide on purpose so long folder names are never cut short -->
			<Width>400</Width>
		</Columns>
		<Style_Border>true</Style_Border>
		<Style_VScroll>true</Style_VScroll>
	</Listbox>

	<Button item="SKINW_INIButton">
		<ScreenID>INIButton</ScreenID>
		<Font>2</Font>
		<RelativePosition>true</RelativePosition>
		<AutoStretch>true</AutoStretch>
		<TopAnchorToTop>false</TopAnchorToTop>
		<BottomAnchorToTop>false</BottomAnchorToTop>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>false</RightAnchorToLeft>
		<TopAnchorOffset>58</TopAnchorOffset>
		<BottomAnchorOffset>38</BottomAnchorOffset>
		<LeftAnchorOffset>10</LeftAnchorOffset>
		<RightAnchorOffset>8</RightAnchorOffset>
		<Style_Checkbox>true</Style_Checkbox>
		<Text>Keep my current layout</Text>
		<TooltipReference>Keep your current window positions and sizes instead of using the layout that comes with the skin you're loading.</TooltipReference>
		<Template>BDT_ModernCheckbox</Template>
		<DecalSize>
			<CX>16</CX>
			<CY>16</CY>
		</DecalSize>
		<!-- 20px row, 16px box: offset 2 centres the box on the vertically centred text -->
		<DecalOffset>
			<X>0</X>
			<Y>2</Y>
		</DecalOffset>
		<TextAlignCenter>false</TextAlignCenter>
		<TextAlignVCenter>true</TextAlignVCenter>
		<TextOffsetX>22</TextOffsetX>
	</Button>

	<Button item="SKINW_LoadButton">
		<ScreenID>LoadButton</ScreenID>
		<RelativePosition>true</RelativePosition>
		<AutoStretch>true</AutoStretch>
		<TopAnchorToTop>false</TopAnchorToTop>
		<BottomAnchorToTop>false</BottomAnchorToTop>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>false</RightAnchorToLeft>
		<TopAnchorOffset>32</TopAnchorOffset>
		<BottomAnchorOffset>8</BottomAnchorOffset>
		<LeftAnchorOffset>8</LeftAnchorOffset>
		<RightAnchorOffset>8</RightAnchorOffset>
		<Style_Checkbox>false</Style_Checkbox>
		<Text>Load Skin</Text>
		<TooltipReference>Load the selected skin</TooltipReference>
		<Template>BDT_AchFlat</Template>
	</Button>

	<Screen item="LoadskinWnd">
		<RelativePosition>false</RelativePosition>
		<Location>
			<X>196</X>
			<Y>50</Y>
		</Location>
		<Size>
			<CX>240</CX>
			<CY>300</CY>
		</Size>
		<Style_VScroll>false</Style_VScroll>
		<Style_HScroll>false</Style_HScroll>
		<Style_Transparent>false</Style_Transparent>
		<Text>Load a Skin</Text>
		<DrawTemplate>WDT_AchModern</DrawTemplate>
		<Style_Titlebar>true</Style_Titlebar>
		<Style_Closebox>true</Style_Closebox>
		<Style_Minimizebox>true</Style_Minimizebox>
		<Style_Border>true</Style_Border>
		<Style_Sizable>false</Style_Sizable>
		<Pieces>SKINW_SkinLabel</Pieces>
		<Pieces>SKINW_SkinList</Pieces>
		<Pieces>SKINW_INIButton</Pieces>
		<Pieces>SKINW_LoadButton</Pieces>
	</Screen>
</XML>
