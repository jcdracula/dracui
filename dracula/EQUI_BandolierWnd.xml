<?xml version = "1.0"?>
<XML ID = "EQInterfaceDefinitionLanguage">
	<Schema xmlns = "EverQuestData" xmlns:dt = "EverQuestDataTypes"/>

<!--
	Modernized Bandolier window (206 x 268)
	Client area is 200 x 240 with an 8px margin on all sides (184px content width).
	Top to bottom:
	- Equipped-slot preview: Primary, Secondary, Range, Ammo in one row (40x40, 8px gaps)
	- Full-width weapon set list
	- Auto Swap and Use locked slots, one per line so labels never clip
	- 2 x 2 action buttons (90x20, 4px gaps): Activate / Hot Button, Add / Delete
	All ScreenIDs are unchanged, so the game wires everything up as before.
-->

<!-- Equipped-slot preview row -->

	<Button item = "BW_DisplayButton0">
		<ScreenID>DisplayButton0</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>8</X>
			<Y>8</Y>
		</Location>
		<Size>
			<CX>40</CX>
			<CY>40</CY>
		</Size>
		<TooltipReference>Primary</TooltipReference>
		<Style_Checkbox>false</Style_Checkbox>
		<Text></Text>
		<ButtonDrawTemplate>
			<Normal>A_InvPrimary</Normal>
		</ButtonDrawTemplate>
		<DecalOffset>
			<X>0</X>
			<Y>0</Y>
		</DecalOffset>
		<DecalSize>
			<CX>40</CX>
			<CY>40</CY>
		</DecalSize>
	</Button>

	<Button item = "BW_DisplayButton1">
		<ScreenID>DisplayButton1</ScreenID>
		<RelativePosition>true</RelativePosition>
