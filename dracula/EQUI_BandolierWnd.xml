		<RelativePosition>true</RelativePosition>
		<Location>
			<X>8</X>
			<Y>56</Y>
		</Location>
		<Size>
			<CX>184</CX>
			<CY>88</CY>
		</Size>
		<Columns>
			<Width>164</Width>
		</Columns>
		<Style_Border>true</Style_Border>
		<Style_VScroll>true</Style_VScroll>
	</Listbox>

<!-- Options -->

	<Button item = "BW_AutoSwapButton">
		<ScreenID>AutoSwapButton</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>8</X>
			<Y>150</Y>
		</Location>
		<Size>
			<CX>100</CX>
			<CY>15</CY>
		</Size>
		<Style_Checkbox>true</Style_Checkbox>
		<Text>Auto Swap</Text>
		<Template>BDT_CheckboxWithText</Template>
		<DecalOffset>
			<X>0</X>
			<Y>2</Y>
		</DecalOffset>
		<DecalSize>
			<CX>12</CX>
			<CY>12</CY>
		</DecalSize>
	</Button>

	<Button item = "BW_LockedSlotsButton">
