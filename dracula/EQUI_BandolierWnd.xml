			<X>8</X>
			<Y>166</Y>
		</Location>
		<Size>
			<CX>137</CX>
			<CY>15</CY>
		</Size>
		<TooltipReference>Selecting this allows items in locked inventory slots to be used when changing bandolier sets.</TooltipReference>
		<NoWrap>true</NoWrap>
		<Style_Checkbox>true</Style_Checkbox>
		<Text>Use locked slots</Text>
		<Template>BDT_CheckboxWithText</Template>
		<DecalOffset>
