			<Y>8</Y>
		</Location>
		<Size>
			<CX>40</CX>
			<CY>40</CY>
		</Size>
		<TooltipReference>Range</TooltipReference>
		<Style_Checkbox>false</Style_Checkbox>
		<Text></Text>
		<ButtonDrawTemplate>
			<Normal>A_InvRange</Normal>
		</ButtonDrawTemplate>
