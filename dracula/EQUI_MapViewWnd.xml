	<Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />
	<!--
	   Modernized map window (dracula skin)
	   - the map fills the window on a flat dark backdrop with a 1px frame (dark theme: pair it with the
	     recoloured "Good's Maps" set; maps with black lines will not show up on it)
	   - floating dark panels over the map: search (top-left), pan / centre / zoom (top-right),
	     layers + labels + height filter (bottom-left)
	   - bottom bar: Current Zone, Find, Auto-Zoom / Group / Names checkboxes, Zone Guide, toolbar
	   - layer toggles are joined gold cells; zone / Atlas tabs use the skin's gold accent
	   All art is on wnd_pieces.dds; floating panels draw their own fill piece (no window Background texture).
	-->
	<TextureInfo item="map_icon.tga">
		<Size>
			<CX>64</CX>
			<CY>64</CY>
		</Size>
	</TextureInfo>
