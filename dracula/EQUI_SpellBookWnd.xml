<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
	<Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />
	<!-- ============================================================
	     Modernized spell book, leather-bound
	     - oxblood leather cover with grain and a stitched edge; flat cream pages that shade
	       toward the spine; page numbers in deep gold over a divider
	     - spell tiles keep the game's colour coding: blue rim = beneficial, red rim =
	       detrimental (the game picks BDT_BlueBuff / BDT_RedBuff by name); gold on hover
	     - spell names in dark ink, up to two lines so long names aren't cut short
	     - page arrows are real buttons inside the window, gold on hover, dim when there's
	       no page to turn to; the close X is always visible (it used to appear only on hover)
	     - memorize/scribe bar has a track below the pages so it's clear where it fills
	     Art: sbw_modern.png (EQUI_Animations.xml); tile templates in EQUI_Templates.xml
	     ============================================================ -->
